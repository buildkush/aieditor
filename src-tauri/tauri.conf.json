{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aiditor",
  "version": "0.1.0",
  "identifier": "com.aiditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aiditor",
        "width": 1280,
        "height": 800,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false,
        "theme": "Dark",
        "visible": true,
        "focus": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "**/*",
          "$HOME/**",
          "$HOME/**/*",
          "$APPDATA/**",
          "$APPDATA/**/*",
          "$APPLOCALDATA/**",
          "$APPLOCALDATA/**/*",
          "$DOWNLOAD/**",
          "$DOWNLOAD/**/*",
          "$DOCUMENT/**",
          "$DOCUMENT/**/*",
          "$VIDEO/**",
          "$VIDEO/**/*",
          "$PICTURE/**",
          "$PICTURE/**/*",
          "$AUDIO/**",
          "$AUDIO/**/*",
          "$DESKTOP/**",
          "$DESKTOP/**/*",
          "C:/**",
          "C:/**/*",
          "D:/**",
          "D:/**/*",
          "E:/**",
          "E:/**/*",
          "F:/**",
          "F:/**/*",
          "\\\\?\\**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../speech-lab/backend/*.py": "speech-backend/",
      "../speech-lab/backend/shruti-assets.json": "speech-backend/shruti-assets.json",
      "../speech-lab/backend/whistle-assets.json": "speech-backend/whistle-assets.json",
      "../speech-lab/backend/tara-assets.json": "speech-backend/tara-assets.json",
      "../speech-lab/backend/tested-cpu-assets.json": "speech-backend/tested-cpu-assets.json",
      "../scripts/setup-speech-lab.ps1": "speech-setup/scripts/setup-speech-lab.ps1",
      "../speech-lab/requirements-lock.txt": "speech-setup/speech-lab/requirements-lock.txt"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
